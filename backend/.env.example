# MySQL (Railway provides these automatically)
MYSQLHOST=your-railway-mysql-host
MYSQLUSER=root
MYSQLPASSWORD=your-mysql-password
MYSQLDATABASE=lasu_navigator
MYSQLPORT=3306

# Firebase Admin SDK (paste your service account JSON as one line)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"lasu-navigator",...}

# Server
PORT=5000
