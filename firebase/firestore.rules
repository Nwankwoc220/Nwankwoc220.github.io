// Firestore security rules for LASU Navigator
// - Users store: users/{uid} — only the authenticated user may read/write their own data
// - Students store: students/{uid} — readable by anyone, writable only by the owning authenticated user

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /students/{studentId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == studentId || request.auth.token.admin == true);
    }

    match /students/{studentId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == studentId || request.auth.token.admin == true);
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
