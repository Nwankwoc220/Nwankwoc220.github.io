// Firestore security rules for LASU Navigator
// - Users store: users/{uid} — only the authenticated user may read/write their own data
// - Students store: students/{matric} — readable by anyone (public), writes disabled to prevent abuse

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy student records - allow read, but do not allow public writes
    match /students/{matric} {
      allow read: if true;
      allow write: if false; // Only migrate via trusted backend or admin SDK
    }

    // Deny anything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
